# Copie ce fichier en .env pour le local. En production, mets ces valeurs dans les
# variables d'environnement chiffrées de ton hébergeur, jamais dans le dépôt.

DATABASE_URL=postgres://regie:regie@127.0.0.1:5432/regie
APP_URL=http://localhost:3000

# Deux longues chaînes aléatoires différentes : openssl rand -base64 48
SESSION_SECRET=
MEDIA_SECRET=

# Connexion GitHub (obligatoire en production). Callback : $APP_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OWNER_GITHUB_LOGIN=zenitsu93
# Local seulement : bouton « Entrer en local » sans GitHub. Refusé en production.
DEV_LOGIN=0

# Clés des services. Vide = mode démo pour ce service.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=AYfOkr1hDQYbhigmRZ16
ELEVENLABS_MODEL=eleven_multilingual_v2
APIFY_TOKEN=
APIFY_PINTEREST_ACTOR=automation-lab~pinterest-scraper

# Stockage des images, voix et vidéos : local (un dossier) ou s3 (R2, S3, MinIO…)
STORAGE_DRIVER=local
STORAGE_DIR=./data
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Plafonds de dépense en dollars (Claude, voix, images)
BUDGET_DAY_USD=5
BUDGET_VIDEO_USD=2
