{
  "name": "regie",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @regie/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @regie/db migrate",
    "db:generate": "pnpm --filter @regie/db generate"
  },
  "engines": { "node": ">=22" }
}
