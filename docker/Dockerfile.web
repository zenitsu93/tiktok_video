FROM node:22-bookworm-slim AS deps
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @regie/web build

FROM node:22-bookworm-slim
RUN corepack enable && useradd -m regie
WORKDIR /app
COPY --from=deps --chown=regie /app /app
USER regie
ENV NODE_ENV=production
EXPOSE 3000
CMD ["sh", "-c", "pnpm db:migrate && pnpm --filter @regie/web start"]
